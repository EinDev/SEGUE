settings.server.telnet.set(true)
settings.server.telnet.bind_addr.set("0.0.0.0")
settings.server.telnet.port.set({{ telnet_port }})

target = ref("FILLER")

def notify(slot_id, event, user) =
  thread.run(fun () ->
    try
      ignore(http.post("{{ webhook_url }}",
        headers=[("X-Onair-Secret", "{{ internal_secret }}"), ("Content-Type", "application/json")],
        data=json.stringify(compact=true, {slot = slot_id, event = event, user = user, ts = time()})))
    catch _ do
      log(label="onair", "webhook delivery failed, continuing")
    end
  )
end

# DJ identity/credentials are NOT known at render time - there is no fixed
# per-DJ list anymore. Instead a fixed pool of generic harbor slots is
# provisioned ({{ max_djs }} of them), and each slot's `auth` function asks
# the api, per connection attempt, whether the supplied (user, password) is
# a currently-ready DJ. This lets DJs self-register and get approved live,
# without ever needing to re-render this script or restart Liquidsoap - the
# one thing this whole project exists to avoid doing to the live output.
def check_auth(user, password, address) =
  url = "{{ auth_check_url }}?user=" ^ url.encode(user) ^ "&password=" ^ url.encode(password)
    ^ "&address=" ^ url.encode(address)
  ret = http.get(url, headers=[("X-Onair-Secret", "{{ internal_secret }}")])
  ret == "true"
end
{% for n in range(1, max_djs + 1) %}
slot{{ n }}_user = ref("")

def auth_slot{{ n }}(params) =
  ok = check_auth(params.user, params.password, params.address)
  if ok then
    slot{{ n }}_user := params.user
  end
  ok
end

slot{{ n }} = input.harbor("slot{{ n }}", port={{ harbor_port }}, auth=auth_slot{{ n }}, icy=true,
  on_connect=fun (_) -> notify("slot{{ n }}", "connect", slot{{ n }}_user()),
  on_disconnect=fun () -> begin
    notify("slot{{ n }}", "disconnect", slot{{ n }}_user())
    slot{{ n }}_user := ""
  end)
{% endfor %}
filler = playlist("/filler", mode="randomize", reload_mode="watch")
safety = blank()

radio = switch(
  track_sensitive=false,
  transition_length=0.4,
  [
{% for n in range(1, max_djs + 1) %}
    ({ target() == "slot{{ n }}" }, slot{{ n }}),
{% endfor %}
    ({ true }, fallback(track_sensitive=false, [filler, safety]))
  ]
)

output.harbor(%mp3(bitrate=320), port={{ output_port }}, mount="/live", radio)

def onair_set(arg) =
  target := arg
  target()
end
server.register(namespace="onair", usage="set <slot-id|FILLER>", description="Switch the live on-air target", "set", onair_set)

def onair_status(_) =
  # compact=true is load-bearing, not cosmetic: the telnet client frames
  # responses line-by-line and only parses the first line as JSON, and
  # json.stringify pretty-prints (multi-line) by default once a record
  # nests this deep. Learned this the hard way against the real client.
  json.stringify(compact=true, {
    target = target(),
    slots = {
{% for n in range(1, max_djs + 1) %}
      slot{{ n }} = { connected = (slot{{ n }}_user() != ""), user = slot{{ n }}_user() }{% if not loop.last %},{% endif %}

{% endfor %}
    }
  })
end
server.register(namespace="onair", usage="status", description="Report current target and per-slot connection state", "status", onair_status)
