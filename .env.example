# Copy this file to `.env` and fill in real values before deploying.
# `.env` is loaded automatically by Docker Compose - do not commit it.

# --- DJ harbor passwords -----------------------------------------------
# One per DJ slot defined in config/djs.yaml (as ${DJ1_PASSWORD} etc there).
# Add more DJx_PASSWORD lines here if you add more DJs to config/djs.yaml.
DJ1_PASSWORD=change-me-dj1
DJ2_PASSWORD=change-me-dj2

# --- Shared secret between liquidsoap and api ---------------------------
# Liquidsoap sends this in the X-Onair-Secret header on its harbor
# connect/disconnect webhook; api rejects requests without a match.
# Must be identical for both services (it is - both read this one var).
ONAIR_INTERNAL_SECRET=change-me-internal-secret

# --- Admin login for the api's admin view -------------------------------
# The token/password the event operator uses to reach the admin dashboard.
ONAIR_ADMIN_TOKEN=change-me-admin-token

# --- Liquidsoap connection details (as seen by the api container) ------
# Docker Compose service name of the liquidsoap container - leave as-is
# unless you renamed the service in docker-compose.yml.
ONAIR_LIQUIDSOAP_HOST=liquidsoap
# Liquidsoap's telnet control port, internal to the compose network only.
ONAIR_LIQUIDSOAP_TELNET_PORT=1234

# --- Liquidsoap harbor/output ports (internal, rarely need changing) ---
# Port liquidsoap listens on for DJ encoder connections (input.harbor).
ONAIR_HARBOR_PORT=8005
# Port liquidsoap serves the /live output mount on (output.harbor).
ONAIR_OUTPUT_PORT=8000
# Where liquidsoap POSTs connect/disconnect events. Default already points
# at the api container by its compose service name - only change this if
# you renamed the api service.
ONAIR_WEBHOOK_URL=http://api:8080/internal/harbor/event

# --- What gets shown to DJs (must be reachable from the internet) ------
# The public hostname or IP of this server - shown to DJs in their DJ-view
# so their encoders (Mixxx/VirtualDJ/BUTT) know where to connect. This is
# NOT the Coolify/Traefik domain - it bypasses the proxy entirely, so it
# must be a hostname/IP that resolves directly to this host.
ONAIR_HARBOR_PUBLIC_HOST=your-server-ip-or-hostname
# Public port DJs connect to (must match the host-side port published for
# liquidsoap's harbor port, i.e. ONAIR_HARBOR_PORT unless you remapped it).
ONAIR_HARBOR_PUBLIC_PORT=8005

# --- Behavior tuning -----------------------------------------------------
# Seconds to debounce connect/disconnect events before switching on-air.
ONAIR_DEBOUNCE_SECONDS=2

# --- Storage --------------------------------------------------------------
# Path inside the api container where the SQLite database lives. Backed by
# the ./data volume - keep that volume persistent across redeploys or DJ
# tokens/links become invalid every time you redeploy.
ONAIR_DB_PATH=/data/onair.db

# --- DJ link generation ---------------------------------------------------
# Public https:// origin of the api service (the Coolify domain you attach
# to it, from the outside). Used only by `python -m app.cli tokens` to print
# full, clickable DJ links instead of bare /dj/{token} paths. Optional -
# leave unset and it just prints the paths for you to prepend yourself.
ONAIR_PUBLIC_BASE_URL=https://segue.your-domain.example
