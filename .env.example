# Copy this file to `.env` and fill in real values before deploying.
# `.env` is loaded automatically by Docker Compose - do not commit it.

# --- Shared secret between liquidsoap and api ---------------------------
# Liquidsoap sends this in the X-Onair-Secret header on both its harbor
# connect/disconnect webhook and its per-connection auth-check call to the
# api; api rejects requests without a match. Must be identical for both
# services (it is - both read this one var).
ONAIR_INTERNAL_SECRET=change-me-internal-secret

# --- Admin identity (via Authentik, not a password here) -----------------
# This app has NO login form of its own. The whole domain sits behind a
# Coolify/Traefik Authentik forward-auth middleware (see README) that
# authenticates every human before their request ever reaches this app,
# and injects the authenticated username into a trusted request header.
# ONAIR_ADMIN_USERNAME is simply the one Authentik username who gets admin
# access (the roster/mode/pin/filler controls) - everyone else who logs in
# via Authentik is treated as a DJ.
ONAIR_ADMIN_USERNAME=EinDev
# The header Authentik's forward-auth injects the username into. This is
# Authentik's own documented default for its forwardAuth outposts - only
# change it if your Authentik/Traefik setup configures something else.
ONAIR_AUTH_USERNAME_HEADER=X-authentik-username

# --- Liquidsoap connection details (as seen by the api container) ------
# Docker Compose service name of the liquidsoap container - leave as-is
# unless you renamed the service in docker-compose.yaml.
ONAIR_LIQUIDSOAP_HOST=liquidsoap
# Liquidsoap's telnet control port, internal to the compose network only.
ONAIR_LIQUIDSOAP_TELNET_PORT=1234

# --- DJ slot pool -----------------------------------------------------------
# How many DJs can be approved ("ready") and streaming at the same time.
# Liquidsoap pre-provisions exactly this many generic harbor mounts at
# startup (slot1..slotN) - this is what lets DJs self-register and get
# approved live, without ever restarting Liquidsoap (which would cut off
# whoever is currently on air). Raising this number requires a restart of
# the liquidsoap service (it's baked into the rendered script at boot);
# lowering it is safe as long as no more than the new number are ready at
# once. Must be identical for both services (it is - both read this one
# var: liquidsoap to know how many mounts to render, api to know when to
# reject a "ready" toggle with "all slots full").
ONAIR_MAX_DJS=6

# --- Liquidsoap harbor/output ports (internal, rarely need changing) ---
# Port liquidsoap listens on *inside its container* for DJ encoder
# connections (input.harbor). Leave this alone even if you remap the
# host-side port below - it's an internal, container-to-container detail.
ONAIR_HARBOR_PORT=8005
# Port liquidsoap serves the /live output mount on *inside its container*
# (output.harbor). Same note as above - internal only.
ONAIR_OUTPUT_PORT=8000
# Where liquidsoap POSTs connect/disconnect events. Default already points
# at the api container by its compose service name - only change this if
# you renamed the api service.
ONAIR_WEBHOOK_URL=http://api:8080/internal/harbor/event
# Where liquidsoap asks "is this (username, password) a ready DJ?" on every
# harbor connection attempt. Same default-points-at-api note as above.
ONAIR_AUTH_CHECK_URL=http://api:8080/internal/harbor/auth

# --- Host-side port mapping (only set these if 8005/8000 collide) ------
# These control what port liquidsoap's ports get published as *on the
# Coolify server itself* (docker-compose.yaml's `ports:` mapping). They
# default to the same numbers as ONAIR_HARBOR_PORT/ONAIR_OUTPUT_PORT above,
# so on a dedicated host you never need to touch them. On a shared Coolify
# server where something else already has 8005 or 8000 bound (deploy fails
# with "port is already allocated"), set one or both of these to a free
# port instead - no compose file edit needed.
# ONAIR_HARBOR_HOST_PORT=8005
# ONAIR_OUTPUT_HOST_PORT=8000

# --- What gets shown to DJs (must be reachable from the internet) ------
# The public hostname or IP of this server - shown to DJs in their DJ-view
# so their encoders (Mixxx/VirtualDJ/BUTT) know where to connect. This is
# NOT the Coolify/Traefik domain - it bypasses the proxy entirely, so it
# must be a hostname/IP that resolves directly to this host.
ONAIR_HARBOR_PUBLIC_HOST=your-server-ip-or-hostname
# Public port DJs connect to. Must match whatever ONAIR_HARBOR_HOST_PORT
# actually ends up as on the host (8005 unless you changed it above) - NOT
# necessarily the same as ONAIR_HARBOR_PORT if you remapped the host side.
ONAIR_HARBOR_PUBLIC_PORT=8005

# --- Behavior tuning -----------------------------------------------------
# Seconds to debounce connect/disconnect events before switching on-air.
ONAIR_DEBOUNCE_SECONDS=2

# --- Storage --------------------------------------------------------------
# Path inside the api container where the SQLite database lives. Backed by
# the ./data volume - keep that volume persistent across redeploys, or
# every DJ's login/credentials/ready-status gets wiped on every redeploy
# (there is no config file to fall back to - the DJ roster lives entirely
# in this database now, populated by self-registration via Authentik).
ONAIR_DB_PATH=/data/onair.db
