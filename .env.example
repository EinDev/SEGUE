# Copy this file to `.env` and fill in real values before deploying.
# `.env` is loaded automatically by Docker Compose - do not commit it.

# --- Shared secret between mediamtx and api ------------------------------
# mediamtx sends this on both its connect/disconnect webhook (as the
# X-Onair-Secret header, via the runOnAvailable/runOnUnavailable curl
# commands we write ourselves) and its per-request auth-check call (as a
# ?secret= query param baked into MTX_AUTHHTTPADDRESS in
# docker-compose.yaml - MediaMTX makes that call itself and has no config
# option to attach a custom header to it, so the query-param route is the
# only one available there). api rejects requests without a match.
# Because this value also travels inside a URL, stick to
# letters/digits/hyphens/underscores - anything needing URL-encoding
# (&, #, spaces, ...) will break the query string.
ONAIR_INTERNAL_SECRET=change-me-internal-secret

# --- Admin identity (via your auth layer, not a password here) -----------
# This app has NO login form of its own. The whole domain sits behind a
# reverse proxy / auth layer (see README's "Auth & routing requirements")
# that authenticates every human before their request ever reaches this
# app, and injects the authenticated username into a trusted request
# header. ONAIR_ADMIN_USERNAME is simply the one username who gets admin
# access (the roster/mode/pin/filler controls) - everyone else who
# authenticates successfully is treated as a DJ.
ONAIR_ADMIN_USERNAME=your-admin-username
# The header your auth layer injects the authenticated username into. The
# default below matches Authentik's own documented default for its
# forwardAuth outposts (see README's worked example) - change it if your
# setup injects something else.
ONAIR_AUTH_USERNAME_HEADER=X-authentik-username

# --- MediaMTX connection details (as seen by the api container) --------
# Docker Compose service name of the mediamtx container and its internal
# control API port - leave as-is unless you renamed the service in
# docker-compose.yaml. api polls this (never exposed to the host, same
# treatment the old telnet port got) as its safety net against a missed
# connect/disconnect webhook - the direct analogue of the old
# ONAIR_LIQUIDSOAP_HOST/ONAIR_LIQUIDSOAP_TELNET_PORT pair.
ONAIR_MEDIAMTX_HOST=mediamtx
ONAIR_MEDIAMTX_API_PORT=9997
# mediamtx's internal HLS port (also never exposed to the host - see
# mediamtx/mediamtx.yml). api proxies this for the admin panel's live DJ
# preview thumbnails and connection-quality delay estimate; leave as-is
# unless you changed hlsAddress in mediamtx.yml to something other than
# :8888.
ONAIR_MEDIAMTX_HLS_PORT=8888

# --- DJ slot pool -----------------------------------------------------------
# How many DJs can be approved ("ready") and streaming at the same time.
# Unlike the old Liquidsoap setup, mediamtx does NOT need to be restarted
# when you raise this - its config matches any slot1..slotN by regex and
# authenticates every request live against api, so there's nothing to
# pre-render. Only api needs to know the new ceiling (it's what decides
# when to reject a "ready" toggle with "all slots full"), so raising this
# is a same-day, lower-risk change than it used to be - still avoid doing
# it mid-event out of caution, but it's no longer a hard requirement.
ONAIR_MAX_DJS=6

# --- What DJs push to (must be reachable from the internet) --------------
# The public hostname or IP of this server, shown to DJs in their DJ-view
# as the RTMP server to point OBS's "Custom..." stream service at. This is
# NOT your reverse proxy's domain - it bypasses the proxy entirely, so it
# must be a hostname/IP that resolves directly to this host.
ONAIR_RTMP_PUBLIC_HOST=your-server-ip-or-hostname
# Public port DJs' OBS connects to. Must match whatever ONAIR_RTMP_HOST_PORT
# actually ends up as on the host (1935 unless you changed it below).
ONAIR_RTMP_PUBLIC_PORT=1935

# --- What the LJ machine pulls from (must be reachable from the LJ's own
# network - the internet, or a shared LAN at the venue) ------------------
# Same idea as ONAIR_RTMP_PUBLIC_HOST above, but for the RTSP side the LJ
# controller's OBS reads from (see lj-controller/). Baked into the
# per-slot rtsp_url the api hands the LJ controller over /public/ws/lj -
# lj-controller never has to construct these itself.
ONAIR_RTSP_PUBLIC_HOST=your-server-ip-or-hostname
ONAIR_RTSP_PUBLIC_PORT=8554

# --- LJ controller authentication ----------------------------------------
# The LJ controller (lj-controller/, running on the event operator's own
# machine) isn't a human logging in through your auth layer - it's a bare
# script, so it authenticates with this static shared token instead
# (config.yaml's `lj_token` on that machine must match this exactly).
# Generate it the same way as ONAIR_INTERNAL_SECRET.
ONAIR_LJ_TOKEN=change-me-lj-token
# The single RTSP read credential every slot's stream is served under to
# the LJ machine. It's one shared pair rather than per-DJ because the LJ
# machine is the only RTSP reader this system has - there's no roster of
# "viewers" to distinguish the way there's a roster of DJs.
ONAIR_LJ_READ_USERNAME=ljreader
ONAIR_LJ_READ_PASSWORD=change-me-lj-read-password

# --- Host-side port mapping (only set these if 1935/8554 collide) --------
# These control what port mediamtx's ports get published as *on the
# Docker host itself* (docker-compose.yaml's `ports:` mapping). They
# default to mediamtx's fixed container-internal ports (1935/8554, set in
# mediamtx/mediamtx.yml), so on a dedicated host you never need to touch
# them. On a shared host where something else already has 1935 or 8554
# bound (deploy fails with "port is already allocated"), set one or both
# of these to a free port instead - no compose/mediamtx-config edit
# needed, just update the matching ONAIR_*_PUBLIC_PORT above to match.
# ONAIR_RTMP_HOST_PORT=1935
# ONAIR_RTSP_HOST_PORT=8554

# --- Behavior tuning -----------------------------------------------------
# Seconds to debounce connect/disconnect events before switching on-air.
ONAIR_DEBOUNCE_SECONDS=2

# --- Optional: Coolify + Traefik middleware label -------------------------
# Only relevant if you're deploying via Coolify with Traefik + Authentik
# (see README's "Example: Authentik + Traefik" walkthrough) - leave unset
# for any other deployment. docker-compose.yaml turns an unset/empty value
# here into a harmless no-op label entry on the `api` service, so the
# compose file stays fully generic otherwise.
#
# Set this to the full `key=value` label Coolify needs on the `api` service
# to attach your Authentik forwardAuth middleware to the router it
# auto-generates for the domain you attach in its UI, e.g.:
#   COOLIFY_TRAEFIK_MIDDLEWARE_LABEL=coolify.traefik.middlewares=authentik-auth@file
#
# Set it as a *Coolify-level persistent environment variable* on the
# service (Coolify's own UI, not by editing this file or
# docker-compose.yaml), so it survives every redeploy that regenerates the
# service from the compose file - unlike adding the label by hand in
# Coolify's UI, which gets silently wiped on every such redeploy.
# COOLIFY_TRAEFIK_MIDDLEWARE_LABEL=coolify.traefik.middlewares=authentik-auth@file

# --- Storage --------------------------------------------------------------
# Path inside the api container where the SQLite database lives. Backed by
# the ./data volume - keep that volume persistent across redeploys, or
# every DJ's login/credentials/ready-status gets wiped on every redeploy
# (there is no config file to fall back to - the DJ roster lives entirely
# in this database now, populated by self-registration via your auth
# layer).
ONAIR_DB_PATH=/data/onair.db
